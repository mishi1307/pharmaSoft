    {
      "name": "T - Tokens",
      "item": [
        {
          "name": "T-01 Token sin prefijo Bearer",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "{{tokenVendedor}}"
              }
            ],
            "url": "{{baseUrl}}/productos",
            "description": "El encabezado contiene el token sin la palabra Bearer."
          }
        },
        {
          "name": "T-02 Token alterado",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/productos",
            "description": "El script cambia el último carácter de la firma del token de colección."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const token = pm.collectionVariables.get('tokenVendedor');",
                  "if (!token) { throw new Error('Ejecuta primero A-01 Vendedor'); }",
                  "const parts = token.split('.');",
                  "const last = parts[2];",
                  "parts[2] = last.slice(0, -1) + (last.endsWith('A') ? 'B' : 'A');",
                  "pm.request.headers.upsert({key: 'Authorization', value: 'Bearer ' + parts.join('.')});"
                ]
              }
            }
          ]
        },
        {
          "name": "T-03 Token firmado con secreto anterior",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/productos",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenVendedor}}",
                  "type": "string"
                }
              ]
            },
            "description": "Cambia app.jwt.secret localmente, reinicia y envía el token previamente guardado. Restaura el secreto después."
          }
        },
        {
          "name": "T-04 Token vencido",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/productos",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAdmin}}",
                  "type": "string"
                }
              ]
            },
            "description": "Configura expiracion-minutos: 1, vuelve a iniciar sesión con admin, espera dos minutos y envía este GET. Restaura la configuración al terminar."
          }
        },
        {
          "name": "T-05 Consultar usuario autenticado",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/auth/me",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenVendedor}}",
                  "type": "string"
                }
              ]
            },
            "description": "Decodifica el token de la respuesta A-01 y comprueba sub, authorities, iat y exp; no compartas el token real."
          }
        },
        {
          "name": "T-06 Token malformado",
